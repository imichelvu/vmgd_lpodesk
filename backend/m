dation. This scientific approach is highly regarded by potential funding donors or partners and leads to increased funding for activities. "),x(),w(14,"div",2),de(15,"img",3),x()()())},styles:["h1[_ngcontent-%COMP%], h2[_ngcontent-%COMP%], h3[_ngcontent-%COMP%]{font-style:normal;font-feature-settings:normal;font-variant-caps:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-weight:400;font-stretch:normal;line-height:44px;font-family:Google Sans,Roboto,Noto,sans-serif;-webkit-font-smoothing:antialiased}h1[_ngcontent-%COMP%]{font-size:36px;text-align:center}h2[_ngcontent-%COMP%]{font-size:30px;letter-spacing:0;-webkit-font-smoothing:antialiased;text-align:left}p[_ngcontent-%COMP%]{font-weight:400;font-stretch:normal;font-size:24px;margin-bottom:48px;line-height:1.5em}.text-oneline[_ngcontent-%COMP%]{text-overflow:ellipsis;overflow:hidden;white-space:nowrap}.sector[_ngcontent-%COMP%]{width:100%;margin:5em auto 0;max-width:100em;padding-bottom:96px}.sector[_ngcontent-%COMP%]   .row-height[_ngcontent-%COMP%]{height:100%}.sector[_ngcontent-%COMP%]   mat-card[_ngcontent-%COMP%]{align-self:center;cursor:pointer;overflow:hidden;background:white;color:#33a4ac}.sector[_ngcontent-%COMP%]   mat-card[_ngcontent-%COMP%]   mat-card-title[_ngcontent-%COMP%]{margin-top:1em;white-space:nowrap;color:#000}.sector[_ngcontent-%COMP%]   mat-card[_ngcontent-%COMP%]   mat-card-title[_ngcontent-%COMP%], .sector[_ngcontent-%COMP%]   mat-card[_ngcontent-%COMP%]   mat-card-subtitle[_ngcontent-%COMP%], .sector[_ngcontent-%COMP%]   mat-card[_ngcontent-%COMP%]   mat-card-content[_ngcontent-%COMP%]{font-size:18px;display:flex;justify-content:center;align-items:center;text-align:center;font-weight:500;font-family:Metropolis,Avenir Next,Helvetica Neue,Arial,sans-serif}.sector-content[_ngcontent-%COMP%]{padding-left:5rem;padding-right:5rem}.sector-content[_ngcontent-%COMP%]   ul[_ngcontent-%COMP%]{font-size:24px}.impact-story-image[_ngcontent-%COMP%]{d